//=============================================================================
// MapListMonsterFightClub
// Curated duel-friendly DM maps for the show. The gametype only plays DM
// maps; when bOnly1on1Maps is enabled it also refuses anything outside
// this list (or maps labeled DM-1ON1*).
//=============================================================================
class MapListMonsterFightClub extends MapList
    config;

defaultproperties
{
     Maps(0)="DM-Deck17"
     Maps(1)="DM-Rankin"
     Maps(2)="DM-Curse4"
     Maps(3)="DM-Asbestos"
     Maps(4)="DM-Corrugation"
     Maps(5)="DM-Gestalt"
     Maps(6)="DM-IronDeity"
     Maps(7)="DM-Grendelkeep"
     Maps(8)="DM-Metallurgy"
     Maps(9)="DM-Rrajigar"
     Maps(10)="DM-Antalus"
     Maps(11)="DM-Morpheus3"
     Maps(12)="DM-Gael"
}
